{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gogopher-arch.local/schemas/release-manifest.schema.json",
  "title": "ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "created_at", "schema_version", "activity_set", "definitions", "assets", "bundle_hash"],
  "properties": {
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": 1
    },
    "activity_set": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definition"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "bundle_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"},
        {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
        {"not": {"pattern": "^/"}}
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "path", "content_hash"],
      "properties": {
        "kind": {"enum": ["capability", "activity", "task"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "path": {"$ref": "#/$defs/path"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "bundle_hash": {"$ref": "#/$defs/hash"},
        "rule_set_hash": {"$ref": "#/$defs/hash"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "task"}}},
          "then": {"required": ["bundle_hash"]}
        },
        {
          "if": {"properties": {"kind": {"const": "activity"}}},
          "then": {"required": ["rule_set_hash"]}
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_version", "source", "workspace_path", "bundle_path", "role", "sha256"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_version": {"type": "integer", "minimum": 1},
        "source": {"$ref": "#/$defs/path"},
        "workspace_path": {"$ref": "#/$defs/path"},
        "bundle_path": {"$ref": "#/$defs/path"},
        "role": {"enum": ["starter", "visible_test", "held_out_test", "fixture", "readme"]},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
