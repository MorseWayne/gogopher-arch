{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gogopher-arch.local/schemas/task.schema.json",
  "title": "TaskDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "language", "workspace_root", "files", "editable_paths", "readonly_paths", "limits", "actions", "visible_tests", "held_out_tests", "assessment_rules", "artifact_rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$"},
    "version": {"type": "integer", "minimum": 1},
    "language": {"enum": ["go1.25", "go1.26"]},
    "workspace_root": {"const": "workspace"},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "editable_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "readonly_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "workspace_policy": {"$ref": "#/$defs/workspacePolicy"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_files", "max_file_bytes", "max_total_bytes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304}
      }
    },
    "actions": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "build": {"$ref": "#/$defs/action"},
        "test": {"$ref": "#/$defs/action"},
        "vet": {"$ref": "#/$defs/action"},
        "submit": {"$ref": "#/$defs/action"}
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "level", "title", "body"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "level": {"type": "integer", "minimum": 1, "maximum": 5},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "body": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "solution": {"type": "string", "minLength": 1, "maxLength": 8000},
    "visible_tests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "held_out_tests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
	"race_tests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "assessment_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "stage", "selector", "capability_refs", "evidence_type", "condition"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
		  "stage": {"enum": ["build", "visible_test", "vet", "held_out_test", "race", "ast", "explanation"]},
          "selector": {"type": "object", "minProperties": 1},
          "capability_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityRef"}},
          "evidence_type": {"enum": ["implement", "test", "diagnose"]},
          "condition": {"enum": ["passed", "failed"]}
        }
      }
    },
    "artifact_rules": {
      "type": "object", "additionalProperties": false,
      "required": ["workspace", "logs"],
      "properties": {
        "workspace": {"enum": ["full", "diff"]},
        "logs": {"type": "array", "uniqueItems": true, "items": {"enum": ["build", "test", "vet", "submit"]}}
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"pattern": "^(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"},
        {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
        {"not": {"pattern": "^/"}}
      ]
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "path", "role", "editable", "sha256"],
      "properties": {
        "source": {"$ref": "#/$defs/path"},
        "path": {"$ref": "#/$defs/path"},
		"role": {"enum": ["starter", "visible_test", "held_out_test", "race_test", "fixture", "readme"]},
        "editable": {"type": "boolean"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_ms", "max_output_bytes", "network"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 45000},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "network": {"const": "none"}
      }
    },
    "capabilityRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^M[1-5]-[0-9]{2}$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "workspacePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["allow_new_files", "allow_delete_files"],
      "properties": {
        "allow_new_files": {"type": "boolean"},
        "allow_delete_files": {"type": "boolean"}
      }
    }
  }
}
