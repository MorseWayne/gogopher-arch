  "hints": [
    {
      "id": "migration-name",
      "level": 1,
      "title": "先解析 migration 身份",
      "body": "文件名应包含四位递增序号、小写描述和 .up.sql；不要排序后掩盖输入漂移。"
    },
    {
      "id": "runtime-image",
      "level": 2,
      "title": "builder 与 runtime 分离",
      "body": "builder 固定 Go 工具链并静态构建，runtime 只复制二进制并使用非 root 用户。"
    },
    {
      "id": "same-gates",
      "level": 3,
      "title": "本地与 CI 使用同一语言",
      "body": "Makefile 和 workflow 都应显式覆盖 fmt、vet、test、race、vuln、migration 与 image。"
    }
  ],
