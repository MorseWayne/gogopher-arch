  "hints": [
    {
      "id": "relation-invariants",
      "level": 1,
      "title": "先把不变量分配给约束",
      "body": "身份用 PRIMARY KEY，归属用 foreign key，必填用 NOT NULL，空白字符串用 CHECK，owner 内重复用组合 UNIQUE。"
    },
    {
      "id": "forward-only-upgrade",
      "level": 2,
      "title": "每一步只向前增加能力",
      "body": "0001 建表，0002 只增加索引；不要用 DROP、DELETE、TRUNCATE 或 down migration 伪装升级。"
    },
    {
      "id": "plan-from-query-shape",
      "level": 3,
      "title": "从查询形状反推索引",
      "body": "owner_id 与 enabled 是等值过滤，created_at DESC 是排序；EXPLAIN 应检查完全相同的 SELECT，而不是另一条简化查询。"
    }
  ],
