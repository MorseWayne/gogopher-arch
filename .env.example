# Copy this file to .env and adjust values when local defaults conflict with your machine.

# Published host ports
WEB_PORT=3000
POSTGRES_PORT=5432

# Learning Gateway
APP_ENV=local
LISTEN_ADDRESS=127.0.0.1:8080
LEARNING_SLICE_ENABLED=true
LEARNING_CONTENT_DIR=content/learning
LEARNING_SESSION_TTL=720h
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_LIFETIME=30m
SANDBOX_ENDPOINT=http://127.0.0.1:8081/v1/executions
SANDBOX_RESPONSE_GRACE=2s
SANDBOX_RPC_DEADLINE=35s
EXECUTION_PERSIST_GRACE=5s
EXECUTION_WORKER_LEASE=45s
EXECUTION_WORKER_HEARTBEAT=10s
EXECUTION_WORKER_POLL=250ms
EXECUTION_MAX_CLAIMS=3

# Local Sandbox process (Compose overrides this with its container address)
SANDBOX_LISTEN_ADDRESS=127.0.0.1:8081

# Internal service URLs used by Docker Compose
DATABASE_URL=postgres://user:pass@postgres:5432/gogopher?sslmode=disable

# Local development defaults for bundled infrastructure
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=gogopher
