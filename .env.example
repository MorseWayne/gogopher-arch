# Copy this file to .env and adjust values when local defaults conflict with your machine.

# Docker builds automatically receive these standard proxy variables from the
# shell or .env when they are set. Keep them commented when no proxy is needed.
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# ALL_PROXY=socks5://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1
# BUILD_NETWORK=host

# Base Compose publishes only Web. docker-compose.dev.yml publishes the remaining
# development endpoints on loopback.
WEB_PORT=3000
GATEWAY_PORT=8080
SANDBOX_PORT=8081
POSTGRES_PORT=5432

# Learning Gateway
APP_ENV=local
LISTEN_ADDRESS=127.0.0.1:8080
LEARNING_SLICE_ENABLED=true
LEARNING_CONTENT_DIR=content/learning
LEARNING_SESSION_TTL=720h
DB_MAX_OPEN_CONNECTIONS=10
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_LIFETIME=30m
SANDBOX_ENDPOINT=http://127.0.0.1:8081/v1/executions
SANDBOX_RESPONSE_GRACE=2s
SANDBOX_RPC_DEADLINE=50s
EXECUTION_PERSIST_GRACE=5s
EXECUTION_WORKER_LEASE=60s
EXECUTION_WORKER_HEARTBEAT=10s
EXECUTION_WORKER_POLL=250ms
EXECUTION_MAX_CLAIMS=3
PROJECTION_WORKER_LEASE=30s
PROJECTION_WORKER_POLL=250ms
PROJECTION_WORKER_MAX_ATTEMPTS=5
PROJECTION_WORKER_BASE_BACKOFF=1s
PROJECTION_WORKER_MAX_BACKOFF=1m

# Local Sandbox process (Compose overrides this with its container address)
SANDBOX_LISTEN_ADDRESS=127.0.0.1:8081

# Internal service URLs used by Docker Compose
DATABASE_URL=postgres://user:pass@postgres:5432/gogopher?sslmode=disable
LOCAL_DATABASE_URL=postgres://user:pass@localhost:5432/gogopher?sslmode=disable

# Local development defaults for bundled infrastructure
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=gogopher
